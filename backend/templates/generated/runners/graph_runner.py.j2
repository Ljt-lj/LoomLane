class WorkflowError(RuntimeError):
    pass


class AgentCallError(WorkflowError):
    """An Agent error carrying usage that was already reported by the API."""

    def __init__(
        self,
        message: str,
        usage: dict[str, int] | None = None,
        agent_id: str | None = None,
    ) -> None:
        super().__init__(message)
        self.agent_id = agent_id
        self.usage = usage or {
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
        }


class GateTimeoutError(WorkflowError):
    def __init__(
        self,
        message: str,
        *,
        gate_id: str,
        comment: str,
    ) -> None:
        super().__init__(message)
        self.gate_id = gate_id
        self.comment = comment


@dataclass(frozen=True)
class GateResult:
    decision: str
    comment: str | None
    timed_out: bool = False


@dataclass(frozen=True)
class AgentExecution:
    agent_id: str
    batch_id: str
    inputs: dict[str, Any]


class _Missing:
    pass


MISSING = _Missing()


def _now() -> str:
    return datetime.now(UTC).isoformat()


class EventWriter:
    def __init__(self) -> None:
        self.seq = 0
        self.run_id = os.getenv("LOOMLANE_RUN_ID", "run")
        self._lock = threading.Lock()

    def emit(
        self,
        event_type: str,
        *,
        node_id: str | None = None,
        edge_id: str | None = None,
        data: dict[str, Any] | None = None,
    ) -> None:
        with self._lock:
            self.seq += 1
            event = {
                "seq": self.seq,
                "run_id": self.run_id,
                "ts": _now(),
                "type": event_type,
                "node_id": node_id,
                "edge_id": edge_id,
                "data": data or {},
            }
            sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
            sys.stdout.flush()


def _path_parts(path: str) -> list[str]:
    if not path.startswith("$."):
        raise WorkflowError(f"Invalid condition path: {path}")
    parts = path[2:].split(".")
    if any(not part for part in parts):
        raise WorkflowError(f"Invalid condition path: {path}")
    return parts


def _resolve(root: dict[str, Any], path: str) -> Any:
    current: Any = root
    for part in _path_parts(path):
        if isinstance(current, dict) and part in current:
            current = current[part]
        else:
            return MISSING
    return current


def evaluate_condition(condition: dict[str, Any], root: dict[str, Any]) -> bool:
    op = condition["op"]
    if op == "and":
        return all(evaluate_condition(item, root) for item in condition.get("args", []))
    if op == "or":
        return any(evaluate_condition(item, root) for item in condition.get("args", []))
    if op == "not":
        return not evaluate_condition(condition["args"][0], root)

    left = _resolve(root, condition.get("left", ""))
    right = condition.get("right")
    if op == "exists":
        return left is not MISSING
    if left is MISSING:
        return False
    if op == "eq":
        return left == right
    if op == "ne":
        return left != right
    if op == "lt":
        return left < right
    if op == "lte":
        return left <= right
    if op == "gt":
        return left > right
    if op == "gte":
        return left >= right
    if op == "in":
        return left in right
    if op == "contains":
        return right in left
    raise WorkflowError(f"Unsupported condition operator: {op}")


def _profile_secret_env(profile_id: str) -> str:
    return "LOOMLANE_SECRET_" + re.sub(r"[^A-Za-z0-9]", "_", profile_id).upper()


def _is_local_url(base_url: str) -> bool:
    host = (urlparse(base_url).hostname or "").lower()
    if host == "localhost" or host == "host.docker.internal":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


MAX_IMAGE_BYTES = 20 * 1024 * 1024


def _global_context_chunk(agent: dict[str, Any]) -> str | None:
    global_context = SDL["workflow"].get("global_context")
    if not global_context:
        return None
    applies = global_context.get("applies_to", "all")
    if applies != "all" and agent["id"] not in applies:
        return None
    return global_context["text"]


def _image_prompt(agent: dict[str, Any], inputs: dict[str, Any]) -> str:
    chunks: list[str] = []
    global_chunk = _global_context_chunk(agent)
    global_context = SDL["workflow"].get("global_context") or {}
    if global_chunk and global_context.get("injection") != "suffix":
        chunks.append(global_chunk)
    chunks.append(agent["system_prompt"])
    if global_chunk and global_context.get("injection") == "suffix":
        chunks.append(global_chunk)
    if inputs:
        chunks.append(
            "Create one image from these workflow inputs:\n"
            + json.dumps(inputs, ensure_ascii=False, indent=2)
        )
    return "\n\n".join(chunk for chunk in chunks if chunk)


def _image_media_type(data: bytes) -> tuple[str, str]:
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png", ".png"
    if data.startswith(b"\xff\xd8\xff"):
        return "image/jpeg", ".jpg"
    if (
        len(data) >= 12
        and data.startswith(b"RIFF")
        and data[8:12] == b"WEBP"
    ):
        return "image/webp", ".webp"
    raise WorkflowError(
        "Image service returned data that is not a supported PNG, JPEG, or WebP image"
    )


def _decode_image_base64(encoded: str) -> bytes:
    compact = "".join(encoded.split())
    if not compact:
        raise WorkflowError("Image service returned an empty base64 image")
    if len(compact) > ((MAX_IMAGE_BYTES + 2) // 3) * 4 + 4:
        raise WorkflowError(
            f"Generated image exceeds the {MAX_IMAGE_BYTES}-byte safety limit"
        )
    try:
        data = base64.b64decode(compact, validate=True)
    except (ValueError, TypeError) as exc:
        raise WorkflowError("Image service returned invalid base64 image data") from exc
    if len(data) > MAX_IMAGE_BYTES:
        raise WorkflowError(
            f"Generated image exceeds the {MAX_IMAGE_BYTES}-byte safety limit"
        )
    return data


def _validate_public_image_url(url: str) -> None:
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise WorkflowError("Image URL must use http:// or https://")
    if parsed.username or parsed.password:
        raise WorkflowError("Image URL must not contain embedded credentials")
    try:
        port = parsed.port or (443 if parsed.scheme == "https" else 80)
        addresses = socket.getaddrinfo(
            parsed.hostname,
            port,
            type=socket.SOCK_STREAM,
        )
    except (OSError, ValueError) as exc:
        raise WorkflowError("Image URL host could not be resolved") from exc
    if not addresses:
        raise WorkflowError("Image URL host did not resolve to an address")
    for address in addresses:
        raw_ip = str(address[4][0]).split("%", 1)[0]
        try:
            ip = ipaddress.ip_address(raw_ip)
        except ValueError as exc:
            raise WorkflowError("Image URL resolved to an invalid address") from exc
        if not ip.is_global:
            raise WorkflowError("Image URL resolved to a non-public address")


def _download_image(url: str, timeout: float) -> bytes:
    if url.startswith("data:"):
        header, separator, encoded = url.partition(",")
        if (
            not separator
            or not header.startswith("data:image/")
            or ";base64" not in header
        ):
            raise WorkflowError("Image service returned an invalid data URL")
        return _decode_image_base64(encoded)

    _validate_public_image_url(url)
    try:
        with httpx.Client(timeout=timeout, follow_redirects=False) as client:
            with client.stream(
                "GET",
                url,
                headers={"Accept": "image/*"},
            ) as response:
                if response.status_code < 200 or response.status_code >= 300:
                    raise WorkflowError(
                        f"Image download returned HTTP {response.status_code}"
                    )
                content_length = response.headers.get("content-length")
                if content_length:
                    try:
                        declared_size = int(content_length)
                    except ValueError:
                        declared_size = 0
                    if declared_size > MAX_IMAGE_BYTES:
                        raise WorkflowError(
                            "Generated image exceeds the "
                            f"{MAX_IMAGE_BYTES}-byte safety limit"
                        )
                chunks: list[bytes] = []
                total = 0
                for chunk in response.iter_bytes():
                    total += len(chunk)
                    if total > MAX_IMAGE_BYTES:
                        raise WorkflowError(
                            "Generated image exceeds the "
                            f"{MAX_IMAGE_BYTES}-byte safety limit"
                        )
                    chunks.append(chunk)
                return b"".join(chunks)
    except httpx.TransportError as exc:
        raise WorkflowError(f"Image download failed: {exc}") from exc


def _image_bytes_from_item(item: Any, timeout: float) -> bytes:
    if not isinstance(item, dict):
        raise WorkflowError("Image service response contained an invalid image item")
    encoded = item.get("b64_json")
    if isinstance(encoded, str) and encoded:
        return _decode_image_base64(encoded)
    url = item.get("url")
    if isinstance(url, str) and url:
        return _download_image(url, timeout)
    raise WorkflowError(
        "Image service response item must contain b64_json or url"
    )


def _image_bytes_from_entries(
    entries: Any,
    field_name: str,
    timeout: float,
) -> bytes:
    if not isinstance(entries, list) or not entries:
        raise WorkflowError(
            f"Image service response did not contain {field_name}[0]"
        )
    return _image_bytes_from_item(entries[0], timeout)


def _image_usage(payload: dict[str, Any]) -> dict[str, int]:
    usage = payload.get("usage") or {}
    prompt_tokens = int(
        usage.get("prompt_tokens", usage.get("input_tokens", 0)) or 0
    )
    completion_tokens = int(
        usage.get("completion_tokens", usage.get("output_tokens", 0)) or 0
    )
    total_tokens = int(
        usage.get("total_tokens", prompt_tokens + completion_tokens) or 0
    )
    return {
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "total_tokens": total_tokens,
    }


