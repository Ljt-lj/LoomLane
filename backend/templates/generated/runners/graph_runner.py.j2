def _save_generated_image(
    workspace: Path,
    agent_id: str,
    data: bytes,
) -> dict[str, str]:
    media_type, extension = _image_media_type(data)
    safe_agent_id = re.sub(r"[^A-Za-z0-9_.-]", "_", agent_id)
    relative = (
        Path("generated")
        / "images"
        / safe_agent_id
        / f"{uuid.uuid4().hex}{extension}"
    )
    target = _safe_path(workspace, relative.as_posix())
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    return {
        "path": relative.as_posix(),
        "media_type": media_type,
    }


def _image_error_detail(response: httpx.Response) -> str:
    try:
        payload = response.json()
    except ValueError:
        return response.text[:300]
    if isinstance(payload, dict):
        error = payload.get("error")
        if isinstance(error, dict) and error.get("message"):
            return str(error["message"])
        if isinstance(error, str):
            return error
    return str(payload)[:300]


def _extract_json(content: str) -> dict[str, Any]:
    stripped = content.strip()
    try:
        value = json.loads(stripped)
    except json.JSONDecodeError:
        start = stripped.find("{")
        if start < 0:
            raise WorkflowError("Agent response did not contain a JSON object")
        try:
            value, _ = json.JSONDecoder().raw_decode(stripped[start:])
        except json.JSONDecodeError as exc:
            raise WorkflowError(f"Agent response contained invalid JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise WorkflowError("Agent response must be a JSON object")
    return value


def _safe_path(root: Path, relative: str) -> Path:
    resolved_root = root.resolve()
    target = (resolved_root / relative).resolve()
    if target != resolved_root and resolved_root not in target.parents:
        raise WorkflowError(f"Path '{relative}' escaped the run workspace")
    return target


def _validate_value(value: Any, port: dict[str, Any], workspace: Path) -> Any:
    port_type = port["type"]
    if port_type == "MIXED":
        return value
    if port_type == "TEXT" and not isinstance(value, str):
        raise WorkflowError(f"Port '{port['name']}' requires TEXT")
    if port_type == "DATA" and not isinstance(
        value, (dict, list, str, int, float, bool, type(None))
    ):
        raise WorkflowError(f"Port '{port['name']}' requires DATA")
    if port_type == "FILE":
        if isinstance(value, str):
            value = {"path": value}
        if not isinstance(value, dict) or not isinstance(value.get("path"), str):
            received = json.dumps(value, ensure_ascii=False, default=str)[:300]
            example = '{"path": "generated/example.png"}'
            raise WorkflowError(
                f"Port '{port['name']}' requires a FILE reference "
                f"like {example}; received {received}"
            )
        _safe_path(workspace, value["path"])

    hint = port.get("schema_hint")
    if not hint:
        return value
    expected = hint.get("type")
    type_checks = {
        "string": (str,),
        "number": (int, float),
        "integer": (int,),
        "boolean": (bool,),
        "object": (dict,),
        "array": (list,),
    }
    if expected in type_checks and not isinstance(value, type_checks[expected]):
        raise WorkflowError(f"Port '{port['name']}' does not satisfy schema_hint")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in hint and value < hint["minimum"]:
            raise WorkflowError(f"Port '{port['name']}' is below schema minimum")
        if "maximum" in hint and value > hint["maximum"]:
            raise WorkflowError(f"Port '{port['name']}' is above schema maximum")
    return value


def _output_contract(agent: dict[str, Any]) -> str:
    parts: list[str] = []
    for port in agent["outputs"]:
        description = f'"{port["name"]}" ({port["type"]})'
        if port["type"] == "FILE":
            description += (
                ' as a JSON object shaped like '
                '{"path": "generated/example.png"}'
            )
        parts.append(description)
    return (
        "Return exactly one JSON object and no surrounding prose. "
        f"It must contain these keys: {', '.join(parts)}."
    )


def _json_output_contract(agent: dict[str, Any]) -> str | None:
    config = agent.get("json_output") or {}
    if not config.get("enabled"):
        return None
    template = config.get("template") or {}
    if not template:
        return "Structured output mode is enabled. Return exactly one valid JSON object."
    rendered = json.dumps(template, ensure_ascii=False, indent=2)
    return (
        "Use the following JSON template as the required response shape. "
        "Preserve every key and nesting level. String leaves describe the "
        "content or type to return for that field:\n"
        f"{rendered}"
    )


def _system_prompt(agent: dict[str, Any]) -> str:
    global_chunk: str | None = None
    global_context = SDL["workflow"].get("global_context")
    if global_context:
        applies = global_context.get("applies_to", "all")
        applies_to_agent = applies == "all" or agent["id"] in applies
        if applies_to_agent:
            global_chunk = global_context["text"]
    chunks: list[str] = []
    if global_chunk and global_context and global_context.get("injection") != "suffix":
        chunks.append(global_chunk)
    chunks.append(agent["system_prompt"])
    if global_chunk and global_context and global_context.get("injection") == "suffix":
        chunks.append(global_chunk)
    chunks.append(_output_contract(agent))
    json_contract = _json_output_contract(agent)
    if json_contract:
        chunks.append(json_contract)
    return "\n\n".join(chunks)


def _call_chat_agent(
    agent: dict[str, Any],
    profile: dict[str, Any],
    inputs: dict[str, Any],
    events: EventWriter,
) -> tuple[dict[str, Any], dict[str, int]]:
    api_key = os.getenv(_profile_secret_env(profile["id"]), "")
    if not api_key and not _is_local_url(profile["base_url"]):
        raise WorkflowError(
            f"API credential is not configured for profile '{profile['id']}'"
        )

    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    request_config = profile.get("request", {})
    body: dict[str, Any] = {
        "model": profile["model"],
        "messages": [
            {"role": "system", "content": _system_prompt(agent)},
            {
                "role": "user",
                "content": json.dumps(inputs, ensure_ascii=False, indent=2),
            },
        ],
        "temperature": request_config.get("temperature", 0.2),
    }
    max_tokens = agent.get("limits", {}).get("max_tokens")
    if max_tokens:
        body["max_tokens"] = max_tokens
    json_output = agent.get("json_output") or {}
    if json_output.get("enabled") or profile.get("capabilities", {}).get(
        "structured_output"
    ):
        body["response_format"] = {"type": "json_object"}

    url = profile["base_url"].rstrip("/") + "/chat/completions"
    retries = int(request_config.get("max_retries", 2))
    timeout = float(request_config.get("timeout_seconds", 60))
    last_error: Exception | None = None
    for attempt in range(retries + 1):
        try:
            with httpx.Client(timeout=timeout, follow_redirects=False) as client:
                response = client.post(url, headers=headers, json=body)
        except httpx.TransportError as exc:
            last_error = exc
            if attempt < retries:
                time.sleep(min(2**attempt, 5))
                continue
            break

        if response.status_code == 429 or response.status_code >= 500:
            last_error = httpx.HTTPStatusError(
                f"Agent service returned {response.status_code}",
                request=response.request,
                response=response,
            )
            if attempt < retries:
                time.sleep(min(2**attempt, 5))
                continue
            break
        try:
            response.raise_for_status()
            payload = response.json()
            content = payload["choices"][0]["message"]["content"]
            if not isinstance(content, str):
                raise WorkflowError("Agent response content is not text")
            usage = payload.get("usage") or {}
            normalized_usage = {
                "prompt_tokens": int(usage.get("prompt_tokens", 0) or 0),
                "completion_tokens": int(usage.get("completion_tokens", 0) or 0),
                "total_tokens": int(usage.get("total_tokens", 0) or 0),
            }
            events.emit("token_usage", node_id=agent["id"], data=normalized_usage)
            finish_reason = payload["choices"][0].get("finish_reason")
            if finish_reason in {"length", "max_tokens"}:
                max_tokens_label = max_tokens or "unknown"
                raise AgentCallError(
                    "Agent output was truncated because max_tokens was reached "
                    f"(completion_tokens={normalized_usage['completion_tokens']}, "
                    f"max_tokens={max_tokens_label}). Increase limits.max_tokens "
                    "for this agent.",
                    normalized_usage,
                )
            try:
                outputs = _extract_json(content)
            except WorkflowError as exc:
                raise AgentCallError(str(exc), normalized_usage) from exc
            return outputs, normalized_usage
        except AgentCallError:
            raise
        except (httpx.HTTPStatusError, KeyError, TypeError, ValueError, WorkflowError) as exc:
            last_error = exc
            break
    raise WorkflowError(f"Agent request failed: {last_error}") from last_error


def _call_image_agent(
    agent: dict[str, Any],
    profile: dict[str, Any],
    inputs: dict[str, Any],
    events: EventWriter,
    workspace: Path,
) -> tuple[dict[str, Any], dict[str, int]]:
    if not profile.get("capabilities", {}).get("image_generation"):
        raise WorkflowError(
            f"API Profile '{profile['id']}' does not support image generation"
        )
    outputs = agent.get("outputs") or []
    if len(outputs) != 1 or outputs[0].get("type") != "FILE":
        raise WorkflowError(
            f"Image Agent '{agent['id']}' must define exactly one FILE output"
        )

    api_key = os.getenv(_profile_secret_env(profile["id"]), "")
    if not api_key and not _is_local_url(profile["base_url"]):
        raise WorkflowError(
            f"API credential is not configured for profile '{profile['id']}'"
        )

    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    adapter = _image_adapter(profile)
    image_request = adapter.build_request(agent, profile, inputs)
    request_config = profile.get("request", {})
    retries = int(request_config.get("max_retries", 2))
    timeout = float(request_config.get("timeout_seconds", 60))
    last_error: Exception | None = None

    for attempt in range(retries + 1):
        try:
            with httpx.Client(timeout=timeout, follow_redirects=False) as client:
                response = client.post(
                    image_request.url,
                    headers=headers,
                    json=image_request.body,
                )
        except httpx.TransportError as exc:
            last_error = exc
            if attempt < retries:
                time.sleep(min(2**attempt, 5))
                continue
            break

        if response.status_code == 429 or response.status_code >= 500:
            last_error = WorkflowError(
                f"Image service returned HTTP {response.status_code}: "
                f"{_image_error_detail(response)}"
            )
            if attempt < retries:
                time.sleep(min(2**attempt, 5))
                continue
            break

        try:
            if response.status_code < 200 or response.status_code >= 300:
                raise WorkflowError(
                    f"Image service returned HTTP {response.status_code}: "
                    f"{_image_error_detail(response)}"
                )
            payload = response.json()
            if not isinstance(payload, dict):
                raise WorkflowError("Image service response must be a JSON object")
            usage = _image_usage(payload)
            if usage["total_tokens"]:
                events.emit("token_usage", node_id=agent["id"], data=usage)
            image_data = adapter.extract_image(payload, timeout)
            reference = _save_generated_image(
                workspace,
                agent["id"],
                image_data,
            )
            return {outputs[0]["name"]: reference}, usage
        except (TypeError, ValueError, WorkflowError) as exc:
            last_error = exc
            break

    raise WorkflowError(
        f"Image request failed ({adapter.protocol}): {last_error}"
    ) from last_error


def _call_agent(
    agent: dict[str, Any],
    profile: dict[str, Any],
    inputs: dict[str, Any],
    events: EventWriter,
    workspace: Path,
) -> tuple[dict[str, Any], dict[str, int]]:
    if agent.get("mode", "chat") == "image":
        return _call_image_agent(agent, profile, inputs, events, workspace)
    return _call_chat_agent(agent, profile, inputs, events)


def _write_artifacts(
    agent: dict[str, Any],
    outputs: dict[str, Any],
    workspace: Path,
    step: int,
    batch_id: str,
) -> list[dict[str, Any]]:
    output_dir = agent.get("output_dir") or "artifacts"
    directory = _safe_path(workspace, output_dir)
    directory.mkdir(parents=True, exist_ok=True)
    artifacts: list[dict[str, Any]] = []
    for port in agent["outputs"]:
        safe_batch = re.sub(r"[^A-Za-z0-9_.-]", "_", batch_id)
        name = re.sub(
            r"[^A-Za-z0-9_.-]",
            "_",
            f"{step:05d}-{safe_batch}-{agent['id']}-{port['name']}",
        )
        port_type = port["type"]
        extension = ".json" if port_type == "DATA" else ".txt"
        target = directory / f"{name}{extension}"
        value = outputs[port["name"]]
        if port_type == "FILE":
            source = _safe_path(workspace, value["path"])
            if not source.is_file():
                raise WorkflowError(
                    f"File output '{port['name']}' does not exist: {value['path']}"
                )
            target = directory / f"{name}{source.suffix}"
            shutil.copy2(source, target)
        elif port_type == "DATA":
            target.write_text(
                json.dumps(value, ensure_ascii=False, indent=2) + "\n",
                encoding="utf-8",
            )
        else:
            target.write_text(str(value), encoding="utf-8")
        artifacts.append(
            {
                "agent_id": agent["id"],
                "port": port["name"],
                "path": target.relative_to(workspace.resolve()).as_posix(),
                "type": port_type,
                "step": step,
                "batch_id": batch_id,
                "bytes": target.stat().st_size,
            }
        )
    return artifacts


class WorkflowRuntime:
    def __init__(self, run_inputs: dict[str, Any], workspace: Path) -> None:
        self.run_inputs = run_inputs
        self.workspace = workspace.resolve()
        self.events = EventWriter()
        self.agents = {agent["id"]: agent for agent in SDL["agents"]}
        self.profiles = {
            profile["id"]: profile for profile in SDL["api_profiles"]
        }
        self.inputs: dict[str, dict[str, Any]] = {
            agent_id: {} for agent_id in self.agents
        }
        self.input_batches: dict[str, dict[str, dict[str, Any]]] = {
            agent_id: {} for agent_id in self.agents
        }
        self.outputs: dict[str, dict[str, Any]] = {}
        self.traversals: dict[str, int] = {
            edge["id"]: 0 for edge in SDL["edges"]
        }
        self.usage = {
            "prompt_tokens": 0,
            "completion_tokens": 0,
            "total_tokens": 0,
        }
        self.agent_usage: dict[str, dict[str, int]] = {
            agent_id: {
                "prompt_tokens": 0,
                "completion_tokens": 0,
                "total_tokens": 0,
            }
            for agent_id in self.agents
        }
        self.artifacts: list[dict[str, Any]] = []
        self.pending: deque[AgentExecution] = deque()
        self.scheduled_batches: set[tuple[str, str]] = set()
        self.aggregate_arrivals: dict[tuple[str, str], set[str]] = {}
        self.aggregate_edges: dict[str, list[dict[str, Any]]] = {
            agent_id: [
                edge
                for edge in SDL["edges"]
                if edge["to"] == agent_id and edge["type"] == "AGGREGATE"
            ]
            for agent_id in self.agents
        }
        self._gate_executor: ThreadPoolExecutor | None = None
        self._stop_event = threading.Event()
        self._batch_counter = itertools.count(1)
        self.step = 0
        self.failed_node_id: str | None = None
        self._active_agents: set[str] = set()
        execution = SDL["workflow"]["execution"]
        self.max_steps = int(execution.get("max_steps", 200))
        self.max_parallel = max(1, int(execution.get("max_parallel", 4)))
        self.max_total_tokens = execution.get("max_total_tokens")
        self.gate_dir = Path(
            os.getenv("LOOMLANE_GATE_DIR", str(workspace / "gates"))
        ).resolve()
        self.gate_dir.mkdir(parents=True, exist_ok=True)
        self.gate_counters: dict[str, int] = {}

    def _new_batch_id(self, prefix: str) -> str:
        return f"{prefix}-{next(self._batch_counter)}"

    def _set_input(
        self,
        agent_id: str,
        batch_id: str,
        port_name: str,
        value: Any,
    ) -> None:
        batch_inputs = self.input_batches[agent_id].setdefault(batch_id, {})
        batch_inputs[port_name] = value
        self.inputs[agent_id][port_name] = value

    def _batch_inputs(self, agent_id: str, batch_id: str) -> dict[str, Any]:
        return dict(self.input_batches[agent_id].get(batch_id, {}))

    def _seed_batch_inputs(self, agent_id: str, batch_id: str) -> None:
        batches = self.input_batches[agent_id]
        if batch_id in batches:
            return
        latest_batch_id = next(reversed(batches), None)
        batches[batch_id] = (
            dict(batches[latest_batch_id])
            if latest_batch_id is not None
            else {}
        )

    def _aggregate_ready(self, agent_id: str, batch_id: str) -> bool:
        incoming = self.aggregate_edges[agent_id]
        if not incoming:
            return True
        arrived = self.aggregate_arrivals.get((agent_id, batch_id), set())
        mode = incoming[0].get("aggregate", {}).get("mode", "all")
        if mode == "any":
            return bool(arrived)
        return {edge["id"] for edge in incoming}.issubset(arrived)

    def _required_inputs_ready(self, agent_id: str, batch_id: str) -> bool:
        values = self.input_batches[agent_id].get(batch_id, {})
        return all(
            port["name"] in values
            for port in self.agents[agent_id]["inputs"]
            if port.get("required", True)
        )

    def _enqueue_if_ready(self, agent_id: str, batch_id: str) -> None:
        key = (agent_id, batch_id)
        if key in self.scheduled_batches:
            return
        if not self._required_inputs_ready(agent_id, batch_id):
            return
        if not self._aggregate_ready(agent_id, batch_id):
            return
        self.scheduled_batches.add(key)
        self.pending.append(
            AgentExecution(
                agent_id=agent_id,
                batch_id=batch_id,
                inputs=self._batch_inputs(agent_id, batch_id),
            )
        )

    def _initialize_inputs(self) -> None:
        start_batch = "batch-start"
        for agent_id in SDL["start"]:
            agent = self.agents[agent_id]
            for port in agent["inputs"]:
                if port["name"] in self.run_inputs:
                    self._set_input(
                        agent_id,
                        start_batch,
                        port["name"],
                        self.run_inputs[port["name"]],
                    )
            for port in agent["inputs"]:
                if (
                    port.get("required", True)
                    and port["name"]
                    not in self.input_batches[agent_id].get(start_batch, {})
                ):
                    raise WorkflowError(
                        f"Missing workflow input '{port['name']}' for '{agent_id}'"
                    )
            self._enqueue_if_ready(agent_id, start_batch)

    def _condition_root(self) -> dict[str, Any]:
        return {
            "workflow": {"inputs": self.run_inputs},
            "agents": {
                agent_id: {"outputs": outputs}
                for agent_id, outputs in self.outputs.items()
            },
            "edges": {
                edge_id: {"traversals": count}
                for edge_id, count in self.traversals.items()
            },
            "run": {"step": self.step},
        }

    def _run_agent(self, execution: AgentExecution, step: int) -> dict[str, Any]:
        agent_id = execution.agent_id
        agent = self.agents[agent_id]
        profile = self.profiles[agent["api_profile"]]
        self.events.emit(
            "node_enter",
            node_id=agent_id,
            data={"batch_id": execution.batch_id, "step": step},
        )
        try:
            outputs, usage = _call_agent(
                agent,
                profile,
                execution.inputs,
                self.events,
                self.workspace,
            )
            for port in agent["outputs"]:
                if port["name"] not in outputs:
                    raise WorkflowError(
                        f"Agent '{agent_id}' omitted output port '{port['name']}'"
                    )
                outputs[port["name"]] = _validate_value(
                    outputs[port["name"]],
                    port,
                    self.workspace,
                )
            extra_keys = set(outputs) - {port["name"] for port in agent["outputs"]}
            if extra_keys:
                raise WorkflowError(
                    f"Agent '{agent_id}' returned unexpected ports: "
                    + ", ".join(sorted(extra_keys))
                )
            artifacts = _write_artifacts(
                agent,
                outputs,
                self.workspace,
                step,
                execution.batch_id,
            )
            for artifact in artifacts:
                self.events.emit("artifact_written", node_id=agent_id, data=artifact)
            self.events.emit(
                "node_exit",
                node_id=agent_id,
                data={
                    "status": "succeeded",
                    "batch_id": execution.batch_id,
                    "step": step,
                },
            )
            return {"outputs": outputs, "usage": usage, "artifacts": artifacts}
        except AgentCallError as exc:
            if exc.agent_id is None:
                exc.agent_id = agent_id
            raise
        except Exception as exc:
            usage = getattr(exc, "usage", None)
            raise AgentCallError(str(exc), usage, agent_id) from exc

    def _merge_usage(
        self,
        target: dict[str, int],
        usage: dict[str, int],
    ) -> None:
        for key in ("prompt_tokens", "completion_tokens", "total_tokens"):
            target[key] += int(usage.get(key, 0) or 0)

    def _check_token_limits(self, agent_id: str) -> None:
        agent_limit = self.agents[agent_id].get("limits", {}).get("max_total_tokens")
        if agent_limit is not None and self.agent_usage[agent_id]["total_tokens"] > agent_limit:
            raise WorkflowError(
                f"Agent '{agent_id}' exceeded max_total_tokens={agent_limit}"
            )
        if self.max_total_tokens is not None and self.usage["total_tokens"] > self.max_total_tokens:
            raise WorkflowError(
                f"Workflow exceeded max_total_tokens={self.max_total_tokens}"
            )

    def _propagate_edge(
        self,
        edge: dict[str, Any],
        agent_outputs: dict[str, Any],
        batch_id: str,
        fanout_batch_id: str | None = None,
    ) -> None:
        if edge["type"] in {"FEEDBACK", "LOOP"}:
            self.traversals[edge["id"]] += 1
            limit = edge.get("guard", {}).get("max_traversals")
            if limit is None:
                limit = SDL["workflow"]["execution"].get(
                    "loop_limit_default" if edge["type"] == "LOOP" else "feedback_limit_default",
                    10,
                )
            if self.traversals[edge["id"]] > limit:
                label = "Loop" if edge["type"] == "LOOP" else "Feedback"
                raise WorkflowError(
                    f"{label} edge '{edge['id']}' exceeded max_traversals={limit}"
                )

        if edge["type"] == "FAN_OUT":
            target_batch_id = fanout_batch_id or self._new_batch_id("fanout")
        elif edge["type"] in {"FEEDBACK", "LOOP"}:
            target_batch_id = self._new_batch_id("loop")
        else:
            target_batch_id = batch_id

        if target_batch_id != batch_id:
            self._seed_batch_inputs(edge["to"], target_batch_id)
        mapped: dict[str, Any] = {}
        for mapping in edge["mappings"]:
            source_value = agent_outputs[mapping["from"]]
            self._set_input(
                edge["to"],
                target_batch_id,
                mapping["to"],
                source_value,
            )
            mapped[mapping["to"]] = source_value
        if edge["type"] == "AGGREGATE":
            self.aggregate_arrivals.setdefault(
                (edge["to"], target_batch_id),
                set(),
            ).add(edge["id"])
        self.events.emit(
            "edge_traversed",
            edge_id=edge["id"],
            data={
                "from": edge["from"],
                "to": edge["to"],
                "mapped_ports": list(mapped),
                "batch_id": target_batch_id,
            },
        )
        self._enqueue_if_ready(edge["to"], target_batch_id)

    def _gate_path(self, gate_id: str) -> Path:
        return self.gate_dir / f"{gate_id}.json"

    def _write_gate(self, gate_id: str, payload: dict[str, Any]) -> None:
        path = self._gate_path(gate_id)
        temporary = path.with_suffix(".tmp")
        temporary.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
        temporary.replace(path)

    def _locked_gate_update(
        self,
        gate_id: str,
        updater: Any,
    ) -> dict[str, Any]:
        path = self._gate_path(gate_id)
        lock_path = path.with_suffix(".lock")
        deadline = time.monotonic() + 2
        while True:
            try:
                lock = lock_path.open("x", encoding="utf-8")
                break
            except FileExistsError:
                if time.monotonic() >= deadline:
                    raise WorkflowError(
                        f"Timed out waiting to update human gate '{gate_id}'"
                    )
                time.sleep(0.02)
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
            payload = updater(payload)
            self._write_gate(gate_id, payload)
            return payload
        finally:
            lock.close()
            try:
                lock_path.unlink()
            except FileNotFoundError:
                pass

    def _wait_for_gate(
        self,
        edge: dict[str, Any],
        gate_id: str,
        timeout_seconds: int,
    ) -> GateResult:
        path = self._gate_path(gate_id)
        deadline = time.monotonic() + timeout_seconds
        while True:
            if self._stop_event.is_set():
                raise WorkflowError(
                    f"Workflow stopped while waiting for human gate '{gate_id}'"
                )
            try:
                payload = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                payload = {}
            decision = payload.get("decision")
            if decision in {"approve", "reject"}:
                return GateResult(str(decision), payload.get("comment"))
            if time.monotonic() >= deadline:
                break
            time.sleep(0.1)

        config = edge.get("human_gate") or {}
        on_timeout = config.get("on_timeout", "fail")
        comment = f"Gate timed out after {timeout_seconds}s"

        def mark_timeout(payload: dict[str, Any]) -> dict[str, Any]:
            existing = payload.get("decision")
            if existing in {"approve", "reject"}:
                return payload
            payload.update(
                {
                    "decision": "timeout",
                    "effective_decision": on_timeout,
                    "comment": comment,
                    "resolved_by": "timeout",
                    "decided_at": _now(),
                }
            )
            return payload

        payload = self._locked_gate_update(gate_id, mark_timeout)
        existing = payload.get("decision")
        if existing in {"approve", "reject"}:
            return GateResult(str(existing), payload.get("comment"))
        if on_timeout == "approve":
            return GateResult("approve", comment, timed_out=True)
        if on_timeout == "reject":
            return GateResult("reject", comment, timed_out=True)
        raise GateTimeoutError(
            f"Human gate '{gate_id}' timed out after {timeout_seconds}s",
            gate_id=gate_id,
            comment=comment,
        )

    def _start_gate(
        self,
        edge: dict[str, Any],
        agent_outputs: dict[str, Any],
        batch_id: str,
        executor: ThreadPoolExecutor,
        gate_futures: dict[Future[Any], dict[str, Any]],
    ) -> None:
        edge_id = edge["id"]
        counter = self.gate_counters.get(edge_id, 0) + 1
        self.gate_counters[edge_id] = counter
        gate_id = f"gate-{edge_id}-{counter}"
        config = edge.get("human_gate") or {}
        timeout_seconds = int(config.get("timeout_seconds", 300))
        payload = {
            "gate_id": gate_id,
            "run_id": os.getenv("LOOMLANE_RUN_ID", "run"),
            "edge_id": edge_id,
            "from": edge["from"],
            "to": edge["to"],
            "batch_id": batch_id,
            "prompt": config.get("prompt", "Approve this workflow step before it continues."),
            "requested_at": _now(),
            "timeout_seconds": timeout_seconds,
            "decision": None,
            "comment": None,
        }
        self._write_gate(gate_id, payload)
        self.events.emit(
            "human_gate_waiting",
            edge_id=edge_id,
            data={"gate_id": gate_id, "prompt": payload["prompt"], "timeout_seconds": timeout_seconds},
        )
        future = executor.submit(self._wait_for_gate, edge, gate_id, timeout_seconds)
        gate_futures[future] = {
            "edge": edge,
            "agent_outputs": agent_outputs,
            "batch_id": batch_id,
            "gate_id": gate_id,
        }

    def _process_outgoing(
        self,
        agent_id: str,
        agent_outputs: dict[str, Any],
        batch_id: str,
        executor: ThreadPoolExecutor,
        gate_futures: dict[Future[Any], dict[str, Any]],
    ) -> None:
        root = self._condition_root()
        passed_edges = [
            edge
            for edge in SDL["edges"]
            if edge["from"] == agent_id
            and (
                edge.get("condition") is None
                or evaluate_condition(edge["condition"], root)
            )
        ]
        fanout_batch_id = (
            self._new_batch_id("fanout")
            if any(edge["type"] == "FAN_OUT" for edge in passed_edges)
            else None
        )
        for edge in passed_edges:
            if edge["type"] == "HUMAN_GATE":
                self._start_gate(
                    edge,
                    agent_outputs,
                    batch_id,
                    executor,
                    gate_futures,
                )
            else:
                self._propagate_edge(
                    edge,
                    agent_outputs,
                    batch_id,
                    fanout_batch_id,
                )

    def _apply_gate_result(
        self,
        context: dict[str, Any],
        result: GateResult,
    ) -> None:
        edge = context["edge"]
        gate_id = context["gate_id"]
        decision = result.decision
        comment = result.comment
        self.events.emit(
            "human_gate_resolved",
            edge_id=edge["id"],
            data={
                "gate_id": gate_id,
                "decision": decision,
                "comment": comment,
                "timed_out": result.timed_out,
                "batch_id": context["batch_id"],
            },
        )
        if decision == "approve":
            self._propagate_edge(
                edge,
                context["agent_outputs"],
                context["batch_id"],
            )
            return
        policy = (edge.get("human_gate") or {}).get("on_reject", "fail")
        if policy == "skip":
            return
        raise WorkflowError(f"Human gate '{gate_id}' was rejected")

    def _workflow_outputs(self) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for output in SDL["workflow"]["outputs"]:
            agent_outputs = self.outputs.get(output["agent"])
            if agent_outputs is None or output["port"] not in agent_outputs:
                raise WorkflowError(
                    f"Workflow output '{output['name']}' was not produced"
                )
            result[output["name"]] = agent_outputs[output["port"]]
        return result

    def run(self) -> dict[str, Any]:
        self.events.emit("run_started", data={"workflow": SDL["workflow"]["id"]})
        self._initialize_inputs()
        executor = ThreadPoolExecutor(max_workers=self.max_parallel)
        self._gate_executor = ThreadPoolExecutor(max_workers=self.max_parallel)
        agent_futures: dict[Future[Any], AgentExecution] = {}
        gate_futures: dict[Future[Any], dict[str, Any]] = {}
        try:
            while True:
                if self.max_total_tokens is not None and self.usage["total_tokens"] > self.max_total_tokens:
                    raise WorkflowError(
                        f"Workflow exceeded max_total_tokens={self.max_total_tokens}"
                    )
                slots = self.max_parallel - len(agent_futures)
                while slots > 0 and self.pending:
                    if self.step >= self.max_steps:
                        raise WorkflowError(
                            f"Workflow exceeded max_steps={self.max_steps}"
                        )
                    execution = self.pending.popleft()
                    self.step += 1
                    self._active_agents.add(execution.agent_id)
                    agent_futures[
                        executor.submit(self._run_agent, execution, self.step)
                    ] = execution
                    slots -= 1

                if not agent_futures and not gate_futures:
                    if self.pending:
                        continue
                    break
                completed, _ = wait(
                    [*agent_futures, *gate_futures],
                    return_when=FIRST_COMPLETED,
                )
                for future in completed:
                    if future in gate_futures:
                        context = gate_futures.pop(future)
                        try:
                            result = future.result()
                        except GateTimeoutError as exc:
                            self.failed_node_id = context["edge"]["from"]
                            self.events.emit(
                                "human_gate_resolved",
                                edge_id=context["edge"]["id"],
                                data={
                                    "gate_id": context["gate_id"],
                                    "decision": "timeout",
                                    "effective_decision": "fail",
                                    "comment": exc.comment,
                                    "timed_out": True,
                                    "batch_id": context["batch_id"],
                                },
                            )
                            raise
                        except Exception:
                            self.failed_node_id = context["edge"]["from"]
                            raise
                        self._apply_gate_result(context, result)
                        continue
                    execution = agent_futures.pop(future)
                    self._active_agents.discard(execution.agent_id)
                    try:
                        payload = future.result()
                    except AgentCallError as exc:
                        self._merge_usage(self.usage, exc.usage)
                        self._merge_usage(
                            self.agent_usage[execution.agent_id],
                            exc.usage,
                        )
                        self.failed_node_id = exc.agent_id or execution.agent_id
                        self._check_token_limits(execution.agent_id)
                        raise
                    except Exception:
                        self.failed_node_id = execution.agent_id
                        raise
                    self._merge_usage(self.usage, payload["usage"])
                    self._merge_usage(
                        self.agent_usage[execution.agent_id],
                        payload["usage"],
                    )
                    self.outputs[execution.agent_id] = payload["outputs"]
                    self.artifacts.extend(payload["artifacts"])
                    self._check_token_limits(execution.agent_id)
                    self._process_outgoing(
                        execution.agent_id,
                        payload["outputs"],
                        execution.batch_id,
                        self._gate_executor,
                        gate_futures,
                    )

            workflow_outputs = self._workflow_outputs()
            result = {
                "status": "succeeded",
                "workflow_outputs": workflow_outputs,
                "agent_outputs": self.outputs,
                "agent_usage": self.agent_usage,
                "usage": self.usage,
                "steps": self.step,
                "edge_traversals": self.traversals,
                "artifacts": self.artifacts,
                "error": None,
            }
            self.events.emit("run_finished", data={"status": "succeeded"})
            return result
        finally:
            self._stop_event.set()
            executor.shutdown(wait=True, cancel_futures=True)
            self._gate_executor.shutdown(wait=True, cancel_futures=True)


def _write_result(path: Path, result: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    temporary.replace(path)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", required=True)
    parser.add_argument(
        "--result",
        default=os.getenv("LOOMLANE_RESULT_PATH", "result.json"),
    )
    args = parser.parse_args()
    input_path = Path(args.input)
    result_path = Path(args.result)
    workspace = Path.cwd()

    runtime: WorkflowRuntime | None = None
    try:
        run_inputs = json.loads(input_path.read_text(encoding="utf-8"))
        runtime = WorkflowRuntime(run_inputs, workspace)
        result = runtime.run()
        result.update(
            {
                "run_id": os.getenv("LOOMLANE_RUN_ID", "run"),
                "workflow_hash": os.getenv("LOOMLANE_WORKFLOW_HASH", ""),
            }
        )
        _write_result(result_path, result)
    except Exception as exc:
        failed_node_id = (
            runtime.failed_node_id
            if runtime
            else getattr(exc, "agent_id", None)
        )
        events = runtime.events if runtime else EventWriter()
        events.emit(
            "error",
            node_id=failed_node_id,
            data={"type": exc.__class__.__name__, "message": str(exc)},
        )
        result = {
            "run_id": os.getenv("LOOMLANE_RUN_ID", "run"),
            "workflow_hash": os.getenv("LOOMLANE_WORKFLOW_HASH", ""),
            "status": "failed",
            "workflow_outputs": {},
            "agent_outputs": runtime.outputs if runtime else {},
            "agent_usage": runtime.agent_usage if runtime else {},
            "usage": runtime.usage if runtime else {},
            "steps": runtime.step if runtime else 0,
            "edge_traversals": runtime.traversals if runtime else {},
            "artifacts": runtime.artifacts if runtime else [],
            "error": str(exc),
        }
        _write_result(result_path, result)
        events.emit("run_finished", data={"status": "failed", "error": str(exc)})
        raise SystemExit(1)
